///|
fn render_typed_command_registrar(
  parsed : ParsedTypedModule,
) -> ProtonCommandCodegenOutput {
  let builder = StringBuilder::new()
  builder <+
    #|///|
    #|/// Generated by `proton codegen`. Do not edit by hand.
    #|
    #|
  if parsed.extension_package {
    builder <+
      #|///|
      #|pub fn generated_extension_command_routes() -> Array[@proton_contract.ContractRoute] {
      #|  [
      #|
    for command in parsed.commands {
      builder <+ "    \{command.contract_expression}.contract_route(),\n"
    }
    builder <+
      #|  ]
      #|}
      #|
      #|
  }
  let free_commands = parsed.commands.filter(command => {
    command.receiver_type is None
  })
  if free_commands.length() > 0 {
    render_typed_registrar_function(builder, None, free_commands)
  }
  let receivers : Array[String] = []
  for command in parsed.commands {
    match command.receiver_type {
      Some(receiver) if !receivers.contains(receiver) =>
        receivers.push(receiver)
      _ => ()
    }
  }
  for receiver in receivers {
    render_typed_registrar_function(
      builder,
      Some(receiver),
      parsed.commands.filter(command => command.receiver_type == Some(receiver)),
    )
  }
  ProtonCommandCodegenOutput::{
    source: builder.to_string().trim().to_owned() + "\n",
    warnings: [],
  }
}

///|
pub fn generate_extension_identity(
  id : String,
  js_namespace : String,
  binding_name? : String = "generated_extension_contract",
) -> ProtonCommandCodegenOutput raise {
  validate_identifier("extension identity binding", binding_name)
  let builder = StringBuilder::new()
  builder <+
    $|///|
    $|/// Generated from `proton.ext.json` by `proton codegen --extension-identity`.
    $|/// Do not edit by hand.
    $|
    $|///|
    $|pub let \{binding_name} : @proton_contract.ExtensionContract =
    $|  @proton_contract.extension(
    $|    id=\{mbt_string(id)},
    $|    js_namespace=\{mbt_string(js_namespace)},
    $|  )
    $|
  ProtonCommandCodegenOutput::{ source: builder.to_string(), warnings: [] }
}

///|
fn render_typed_registrar_function(
  builder : StringBuilder,
  receiver : String?,
  commands : Array[ParsedTypedCommand],
) -> Unit {
  builder <+
    #|///|
    #|
  match receiver {
    Some(receiver) =>
      builder <+
        $|pub fn \{receiver}::register_commands(
        $|  self : \{receiver},
        $|
    None =>
      builder <+
        #|pub fn register_commands(
        #|
  }
  builder <+
    #|  registrar : @proton.CommandRegistrar,
    #|) -> Unit raise {
    #|
  for command in commands {
    builder <+
      $|  registrar.bind(
      $|    \{command.contract_expression},
      $|
    builder <+ "    "
    render_typed_handler(builder, command)
    builder <+
      #|,
      #|  )
      #|
  }
  builder <+
    #|}
    #|
    #|
}

///|
fn render_typed_handler(
  builder : StringBuilder,
  command : ParsedTypedCommand,
) -> Unit {
  let context_parameter = if command.accepts_context {
    "context"
  } else {
    "_context"
  }
  let request_parameter = if command.has_request {
    "request"
  } else {
    "_request"
  }
  let qualifier = match command.receiver_type {
    Some(_) => "self."
    None => ""
  }
  let arguments : Array[String] = []
  if command.accepts_context {
    arguments.push("context")
  }
  if command.has_request {
    arguments.push("request")
  }
  builder <+
    "(\{context_parameter}, \{request_parameter}) => \{qualifier}\{command.function_name}(\{arguments.join(", ")})"
}
