///|
fn render_typed_command_registrar(
  parsed : ParsedTypedModule,
) -> ProtonCommandCodegenOutput {
  let builder = StringBuilder::new()
  builder.write_string("///|\n")
  builder.write_string(
    "/// Generated by `proton codegen`. Do not edit by hand.\n\n",
  )
  match parsed.extension_identity {
    Some((id, js_namespace)) => {
      builder.write_string("///|\n")
      builder.write_string(
        "pub let generated_extension_contract : @proton_contract.ExtensionContract =\n",
      )
      builder.write_string("  @proton_contract.extension(\n")
      builder.write_string("    id=")
      builder.write_string(mbt_string(id))
      builder.write_string(",\n")
      builder.write_string("    js_namespace=")
      builder.write_string(mbt_string(js_namespace))
      builder.write_string(",\n")
      builder.write_string("  )\n\n")
      builder.write_string("///|\n")
      builder.write_string(
        "pub fn generated_extension_command_routes() -> Array[@proton_contract.ContractRoute] {\n",
      )
      builder.write_string("  [\n")
      for command in parsed.commands {
        builder.write_string("    ")
        builder.write_string(command.contract_expression)
        builder.write_string(".contract_route(),\n")
      }
      builder.write_string("  ]\n")
      builder.write_string("}\n\n")
    }
    None => ()
  }
  let free_commands = parsed.commands.filter(command => {
    command.receiver_type is None
  })
  if free_commands.length() > 0 {
    render_typed_registrar_function(builder, None, free_commands)
  }
  let receivers : Array[String] = []
  for command in parsed.commands {
    match command.receiver_type {
      Some(receiver) if !receivers.contains(receiver) =>
        receivers.push(receiver)
      _ => ()
    }
  }
  for receiver in receivers {
    render_typed_registrar_function(
      builder,
      Some(receiver),
      parsed.commands.filter(command => command.receiver_type == Some(receiver)),
    )
  }
  ProtonCommandCodegenOutput::{ source: builder.to_string(), warnings: [] }
}

///|
fn render_typed_registrar_function(
  builder : StringBuilder,
  receiver : String?,
  commands : Array[ParsedTypedCommand],
) -> Unit {
  builder.write_string("///|\n")
  match receiver {
    Some(receiver) => {
      builder.write_string("pub fn ")
      builder.write_string(receiver)
      builder.write_string("::register_commands(\n")
      builder.write_string("  self : ")
      builder.write_string(receiver)
      builder.write_string(",\n")
    }
    None => builder.write_string("pub fn register_commands(\n")
  }
  builder.write_string("  registrar : @proton.CommandRegistrar,\n")
  builder.write_string(") -> Unit raise {\n")
  for command in commands {
    builder.write_string("  registrar.bind(\n")
    builder.write_string("    ")
    builder.write_string(command.contract_expression)
    builder.write_string(",\n")
    builder.write_string("    ")
    render_typed_handler(builder, command)
    builder.write_string(",\n")
    builder.write_string("  )\n")
  }
  builder.write_string("}\n\n")
}

///|
fn render_typed_handler(
  builder : StringBuilder,
  command : ParsedTypedCommand,
) -> Unit {
  let needs_adapter = command.receiver_type is Some(_) ||
    !command.accepts_context ||
    !command.has_request
  if !needs_adapter {
    builder.write_string(command.function_name)
    return
  }
  builder.write_string("(")
  builder.write_string(
    if command.accepts_context {
      "context"
    } else {
      "_context"
    },
  )
  builder.write_string(", ")
  builder.write_string(if command.has_request { "request" } else { "_request" })
  builder.write_string(") => ")
  match command.receiver_type {
    Some(_) => builder.write_string("self.")
    None => ()
  }
  builder.write_string(command.function_name)
  builder.write_string("(")
  let arguments : Array[String] = []
  if command.accepts_context {
    arguments.push("context")
  }
  if command.has_request {
    arguments.push("request")
  }
  builder.write_string(arguments.join(", "))
  builder.write_string(")")
}
