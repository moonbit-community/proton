          #|///|
          #|test "business failures and old create replies preserve newer user input" {
          #|  let model = { ..initial_model(), draft: "new draft", }
          #|  let failed = test_update(model, Created("submitted", @shared.InvalidTitle))
          #|  assert_eq(failed.draft, "new draft")
          #|  assert_eq(failed.error, Some("Enter a non-empty title."))
          #|  let succeeded = test_update(
          #|    model,
          #|    Created("submitted", @shared.Changed(version=1)),
          #|  )
          #|  assert_eq(succeeded.draft, "new draft")
          #|}
          #|
      ),
    },
  ]
}

///|
fn generated_minimal_template_specs() -> Array[TemplateSpec] {
  [
    {
      output_path: "moon.mod",
      template_name: "minimal/moon.mod.mtpl",
      template_source: (
          #|name = "{{module_name}}"
          #|
          #|version = "0.1.0"
          #|
          #|import {
          #|  "moonbitlang/async@{{async_version}}",
          #|  "moonbit-community/proton@{{proton_version}}",
          #|}
          #|
          #|license = "Apache-2.0"
          #|
          #|description = "A minimal Proton desktop application."
          #|
          #|options(
          #|  warn_list: "",
          #|  preferred_target: "native",
          #|  supported_targets: "+native",
          #|)
          #|
      ),
    },
    {
      output_path: "app/moon.pkg",
      template_name: "minimal/app/moon.pkg.mtpl",
      template_source: (
          #|import {
          #|  "moonbitlang/async",
          #|  "moonbit-community/proton",
          #|}
          #|
          #|supported_targets = "native"
          #|
          #|pkgtype(kind: "executable")
          #|
      ),
    },
    {
      output_path: "app/main.mbt",
      template_name: "minimal/app/main.mbt.mtpl",
      template_source: (
          #|///|
          #|async fn main {
          #|  let html =
          #|    #|<!doctype html>
          #|    #|<html lang="en">
          #|    #|  <head>
          #|    #|    <meta charset="utf-8">
          #|    #|    <meta name="viewport" content="width=device-width, initial-scale=1">
          #|    #|    <title>{{title_html}}</title>
          #|    #|    <style>
          #|    #|      :root { color-scheme: light dark; font-family: system-ui, sans-serif; }
          #|    #|      body { display: grid; min-height: 100vh; margin: 0; place-items: center; }
          #|    #|    </style>
          #|    #|  </head>
          #|    #|  <body>
          #|    #|    <main>
          #|    #|      <h1>{{title_html}}</h1>
          #|    #|      <p>Your minimal Proton app is running.</p>
          #|    #|    </main>
          #|    #|  </body>
          #|    #|</html>
          #|  @proton.html({{title_mbt}}, html, width={{width}}, height={{height}})
          #|  .load_config()
          #|  .run_or_abort()
          #|}
          #|
      ),
    },
    {
      output_path: "README.md",
      template_name: "minimal/README.md.mtpl",
      template_source: (
          #|# {{title}}
          #|
          #|A minimal Proton desktop app generated by `proton_cli new --template minimal`.
          #|
          #|The application is a single MoonBit module. Its native entry point and inline
          #|HTML live in `app/main.mbt`; no separate frontend toolchain is required.
          #|The app calls `.load_config()` to load its required application identity from
          #|`proton.project.json` during development and packaged metadata after release.
          #|
          #|## Setup
          #|
          #|```sh
          #|moon update
          #|proton_cli cef setup
          #|```
          #|
          #|## Check
          #|
          #|```sh
          #|moon check --target native --diagnostic-limit 80
          #|```
          #|
          #|## Dev
          #|
          #|```sh
          #|proton_cli dev
          #|```
          #|
          #|## Build
          #|
          #|```sh
          #|proton_cli build
          #|```
          #|
          #|## Package
          #|
          #|```sh
          #|proton_cli package --dry-run
          #|proton_cli package --release
          #|```
          #|
      ),
    },
    {
      output_path: ".gitignore",
      template_name: "minimal/.gitignore.mtpl",
      template_source: (
          #|.DS_Store
          #|_build/
          #|dist/
          #|.mooncakes/
          #|.moonagent/
          #|
      ),
    },
  ]
}
