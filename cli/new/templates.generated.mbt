          #|                  }
          #|                },
          #|                error => {
          #|                  if active.val {
          #|                    failed.val = true
          #|                    scheduler.add(emit(ListenFailed(model.listener, error)))
          #|                  }
          #|                },
          #|              )
          #|              () => subscription.close()
          #|            } else {
          #|              () => ()
          #|            }
