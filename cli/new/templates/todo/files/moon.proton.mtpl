product_name = {{title_mbt}}
identifier = {{identifier_mbt}}

window = {
  title: {{title_mbt}},
  width: {{width}},
  height: {{height}},
  size_hint: "none",
}

backend = {
  path: "backend",
  package: "app",
}

frontend = {
  path: "frontend",
  dev_url: "http://127.0.0.1:4300",
  before_dev: "warren dev --port 4300",
  before_build: "warren build",
  dist: "dist",
}

entry = {
  kind: "asset",
  value: "frontend/dist/index.html",
}

debug = true

bundle = {
  active: true,
  targets: ["app", "zip"],
  output: "target/proton-dist",
}
