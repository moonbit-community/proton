import {
  "moonbit-community/proton_cli/project",
  "moonbit-community/proton_config",
  "moonbit-community/proton_package/lib" @packager,
  "moonbit-community/proton_package/arguments" @package_args,
  "moonbit-community/proton_cefsetup/store" @cef_store,
  "moonbit-community/proton_updater" @updater,
  "moonbit-community/proton_cli/build_cmd" @build,
  "moonbit-community/proton_cli/fsutil",
  "moonbit-community/proton_cli/output",
  "moonbitlang/core/async/fs" @async_fs,
  "moonbitlang/core/async/process",
  "moonbitlang/core/argparse",
  "moonbitlang/core/debug",
  "moonbitlang/x/crypto",
  "moonbitlang/x/path",
}

import {
  "moonbitlang/core/async",
  "moonbitlang/core/env",
} for "wbtest"

supported_targets = "native+wasm"

options(
  "allow-experimental-packages": true,
)
