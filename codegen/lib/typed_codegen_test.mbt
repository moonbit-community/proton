///|
test "typed codegen renders free and receiver registrars" {
  let generated = generate_typed_commands_from_sources([
    (
      "commands.mbt",
      (
        #|///|
        #|let ping_contract = @shared.ping
        #|
        #|///|
        #|#proton.command(contract=ping_contract)
        #|fn ping() -> String {
        #|  "pong"
        #|}
        #|
        #|///|
        #|let current_window_contract = @shared.current_window
        #|
        #|///|
        #|#proton.command(contract=current_window_contract)
        #|fn current_window(context : @proton.CommandContext) -> Int64 {
        #|  context.window_handle()
        #|}
        #|
        #|///|
        #|using @shared {create_todo}
        #|
        #|///|
        #|#proton.command(contract=create_todo)
        #|async fn Backend::create_todo(
        #|  self : Backend,
        #|  context : @proton.CommandContext,
        #|  request : @shared.CreateTodoRequest,
        #|) -> @shared.Todo {
        #|  self.create(context, request)
        #|}
        #|
      ),
    ),
  ])
  let expected =
    #|///|
    #|/// Generated by `proton_codegen`. Do not edit by hand.
    #|
    #|///|
    #|pub fn register_commands(
    #|  registrar : @proton.CommandRegistrar,
    #|) -> Unit raise {
    #|  registrar.bind(
    #|    ping_contract,
    #|    (_context, _request) => ping(),
    #|  )
    #|  registrar.bind(
    #|    current_window_contract,
    #|    (context, _request) => current_window(context),
    #|  )
    #|}
    #|
    #|///|
    #|pub fn Backend::register_commands(
    #|  self : Backend,
    #|  registrar : @proton.CommandRegistrar,
    #|) -> Unit raise {
    #|  registrar.bind(
    #|    create_todo,
    #|    (context, request) => self.create_todo(context, request),
    #|  )
    #|}
    #|
  inspect(generated.source, content=expected)
  assert_eq(generated.warnings, [])
}

///|
test "typed codegen combines explicit source inputs" {
  let generated = generate_typed_commands_from_sources([
    (
      "read.mbt",
      (
        #|let read_contract = @shared.read
        #|
        #|#proton.command(contract=read_contract)
        #|fn read(request : String) -> String {
        #|  request
        #|}
        #|
      ),
    ),
    (
      "write.mbt",
      (
        #|let write_contract = @shared.write
        #|
        #|#proton.command(contract=write_contract)
        #|fn write(request : String) -> Unit {
        #|  ignore(request)
        #|}
        #|
      ),
    ),
  ])
  assert_true(generated.source.contains("read_contract"))
  assert_true(generated.source.contains("write_contract"))
}

///|
test "typed codegen emits extension routes without duplicating identity" {
  let generated = generate_typed_commands_from_sources(
    [
      (
        "extension.mbt",
        (
          #|#proton.command(contract=read_text)
          #|fn read_text(request : ReadTextRequest) -> ReadTextReply {
          #|  read(request)
          #|}
          #|
        ),
      ),
    ],
    extension_package=true,
  )
  assert_false(generated.source.contains("id="))
  assert_false(generated.source.contains("js_namespace="))
  assert_true(
    generated.source.contains(
      "pub fn generated_extension_command_routes() -> Array[@proton_contract.ContractRoute]",
    ),
  )
  assert_true(generated.source.contains("read_text.contract_route()"))
}

///|
test "extension identity generation renders moon ext identity" {
  let generated = generate_extension_identity(
    "moonbit-community/proton-clipboard",
    "clipboard",
    binding_name="extension",
  )
  assert_true(
    generated.source.contains(
      "pub let extension : @proton_contract.ExtensionContract",
    ),
  )
  assert_true(
    generated.source.contains("id=\"moonbit-community/proton-clipboard\""),
  )
  assert_true(generated.source.contains("js_namespace=\"clipboard\""))
}

///|
test "typed codegen parses extend declarations" {
  let generated = generate_typed_commands_from_sources([
    (
      "commands.mbt",
      (
        #|struct Request {}
        #|
        #|pub extend Request with ToJson::{to_json}
        #|
        #|#proton.command(contract=ping)
        #|fn ping() -> Unit {}
        #|
      ),
    ),
  ])
  assert_true(generated.source.contains("registrar.bind(\n    ping,"))
}

///|
test "typed codegen requires an unqualified contract reference" {
  try {
    ignore(
      generate_typed_commands_from_sources([
        (
          "commands.mbt",
          (
            #|#proton.command(contract=@shared.ping)
            #|fn ping() -> Unit {}
            #|
          ),
        ),
      ]),
    )
    fail("expected unqualified contract reference error")
  } catch {
    CommandCodegenError::Attribute(
      kind="command",
      detail="MoonBit attributes cannot contain package-qualified values; import the contract with `using` and pass its unqualified name"
    ) => ()
    _ => fail("expected unqualified contract reference error")
  }
}
