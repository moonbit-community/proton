import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/http",
  "moonbitlang/async/process",
  "moonbitlang/async/socket",
  "moonbitlang/core/debug",
  "moonbitlang/core/encoding/base64",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
  "moonbitlang/x/fs" @mbfs,
  "moonbitlang/x/path",
  "moonbit-community/proton/examples/app_commands_fixture",
  "moonbit-community/proton/examples/e2e_fixtures",
  "moonbit-community/proton_cdp/client",
  "moonbit-community/proton_cdp/protocol/typed",
