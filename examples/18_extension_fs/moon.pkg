import {
  "moonbitlang/async",
  "moonbit-community/proton_ext/fs",
  "moonbit-community/proton",
}

supported_targets = "native"

dev_build(rule: "embed", input: "fs.html", output: "fs.mbt")

formatter(ignore: [ "fs.mbt" ])

pkgtype(kind: "executable")

options(
  targets: { "main.mbt": [ "native" ] },
)
