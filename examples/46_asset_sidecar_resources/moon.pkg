import {
  "moonbitlang/x/fs" @mbfs,
  "moonbitlang/core/json",
  "moonbitlang/async",
  "justjavac/proton/extension" @proton_extension,
  "justjavac/proton_contract",
  "justjavac/proton",
}

supported_targets = "native"

dev_build(
  rule: "proton_codegen",
  input: "commands.mbt",
  output: "commands.g.mbt",
)

dev_build(
  rule: "proton_extension_identity_codegen",
  input: "moon.ext",
  output: "extension_identity.g.mbt",
)

formatter(ignore: [ "commands.g.mbt", "extension_identity.g.mbt" ])

pkgtype(kind: "executable")

options(
  targets: {
    "commands.g.mbt": [ "native" ],
    "commands.mbt": [ "native" ],
    "extension_identity.g.mbt": [ "native" ],
    "main.mbt": [ "native" ],
  },
)
