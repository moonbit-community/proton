{
  "identifier": "com.justjavac.proton.dev-extension-js",
  "backend": {
    "path": "../..",
    "package": "examples/47_dev_extension_js"
  },
  "frontend": {
    "path": "frontend",
    "dev_url": "http://127.0.0.1:4300",
    "dist": "dist",
    "before_dev": "warren dev --browser-entry main --direct --port 4300",
    "before_build": "warren build --browser-entry main"
  },
  "package": {
    "product_name": "Proton Dev Extension JS",
    "version": "0.1.0",
    "formats": [
      "app",
      "zip"
    ],
    "output": "dist"
  }
}
