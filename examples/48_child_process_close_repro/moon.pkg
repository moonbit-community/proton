import {
  "moonbitlang/async",
  "moonbitlang/async/process",
  "moonbitlang/core/json",
  "justjavac/proton/extension" @proton_extension,
  "justjavac/proton_contract",
  "justjavac/proton",
}

supported_targets = "native"

pkgtype(kind: "executable")

options(
  targets: { "app.mbt": [ "native" ], "main.mbt": [ "native" ] },
)
