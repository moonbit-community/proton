import {
  "moonbitlang/core/async",
  "moonbit-community/proton",
}

supported_targets = "native"

dev_build(rule: "embed", input: "index.html", output: "index.mbt")

formatter(ignore: [ "index.mbt" ])

pkgtype(kind: "executable")

options(
  "allow-experimental-packages": true,
  targets: { "index.mbt": [ "native" ], "main.mbt": [ "native" ] },
)
