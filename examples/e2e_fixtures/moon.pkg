import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/pipe",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
  "moonbitlang/x/fs" @mbfs,
  "justjavac/proton/core",
  "justjavac/proton/extension" @proton_extension,
  "justjavac/proton_contract",
  "justjavac/proton/native",
  "justjavac/proton",
}

supported_targets = "native"

warnings = "-unused_package"

dev_build(
  rule: "proton_codegen",
  input: "commands.mbt",
  output: "commands.g.mbt",
)

formatter(ignore: [ "commands.g.mbt" ])
