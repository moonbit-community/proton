import {
  "moonbitlang/async",
  "moonbitlang/async/http",
  "moonbitlang/async/io",
  "moonbitlang/async/socket",
  "moonbitlang/async/fs",
  "moonbitlang/async/os_error",
  "moonbitlang/async/pipe",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
  "moonbitlang/x/fs" @mbfs,
  "moonbit-community/proton/core",
  "moonbit-community/proton/extension" @proton_extension,
  "moonbit-community/proton_contract",
  "moonbit-community/proton",
  "moonbit-community/proton_ext/process" @process_extension,
}

supported_targets = "native"

warnings = "-unused_package"

dev_build(
  rule: "proton_codegen",
  input: "commands.mbt",
  output: "commands.g.mbt",
)

formatter(ignore: [ "commands.g.mbt" ])
