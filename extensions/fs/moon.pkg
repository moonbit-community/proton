import {
  "moonbitlang/core/debug",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
  "moonbitlang/async",
  "moonbitlang/async/fs" @async_fs,
  "moonbitlang/x/path" @mbpath,
  "moonbit-community/proton",
  "moonbit-community/proton/extension" @proton_extension,
  "moonbit-community/proton_contract",
  "moonbit-community/proton_ext/fs/contract" @fs_contract,
}

import {
  "moonbitlang/core/debug",
  "moonbitlang/async",
  "moonbit-community/proton/core" @proton_core,
} for "wbtest"

supported_targets = "native"

formatter(ignore: [ "extension.g.mbt" ])

options(
  targets: {
    "extension.g.mbt": [ "native" ],
    "extension.mbt": [ "native" ],
    "fs_api.mbt": [ "native" ],
    "permission.mbt": [ "native" ],
    "fs_wbtest.mbt": [ "native" ],
  },
)
