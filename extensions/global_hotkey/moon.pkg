import {
  "moonbitlang/core/json",
  "moonbit-community/global_hotkey" @sys_global_hotkey,
  "moonbit-community/proton",
  "moonbit-community/proton/extension" @proton_extension,
  "moonbit-community/proton_contract",
  "moonbit-community/proton_ext/global_hotkey/contract" @global_hotkey_contract,
}

supported_targets = "native"

formatter(ignore: [ "extension.g.mbt" ])

options(
  targets: {
    "extension.g.mbt": [ "native" ],
    "extension.mbt": [ "native" ],
    "extension_wbtest.mbt": [ "native" ],
    "global_hotkey.mbt": [ "native" ],
  },
)
