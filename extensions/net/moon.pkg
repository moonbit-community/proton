import {
  "moonbitlang/core/debug",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/async/http",
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/os_error",
  "moonbitlang/core/random",
  "moonbitlang/core/string",
  "moonbitlang/x/path",
  "moonbit-community/proton",
  "moonbit-community/proton/extension" @proton_extension,
  "moonbit-community/proton_ext/net/contract" @net_contract,
}

import {
  "moonbitlang/core/async/socket",
} for "test"

supported_targets = "native"

formatter(ignore: [ "extension.g.mbt" ])

options(
  "allow-experimental-packages": true,
  targets: { "extension.g.mbt": [ "native" ], "extension.mbt": [ "native" ] },
)
