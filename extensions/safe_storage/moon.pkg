import {
  "moonbit-community/proton_safe_storage" @sys_safe_storage,
  "moonbit-community/proton",
  "moonbit-community/proton/extension" @proton_extension,
  "moonbit-community/proton_contract",
  "moonbit-community/proton_ext/safe_storage/contract" @safe_storage_contract,
}

supported_targets = "native"

formatter(ignore: [ "extension.g.mbt" ])

import {
  "moonbit-community/proton/core",
} for "wbtest"

options(
  targets: { "extension.g.mbt": [ "native" ], "extension.mbt": [ "native" ] },
)
