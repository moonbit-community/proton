import {
  "moonbit-community/proton/internal/native/cef_loader",
  "moonbit-community/proton/internal/native/ffi_mac" @mac_engine,
  "moonbit-community/proton_ffi",
}

supported_targets = "native"

options(
  "is-main": false,
  "native-stub": [
    "src/proton_app_instance.c",
    "src/proton_bridge_config.c",
    "src/proton_config.c",
    "src/proton_event.c",
    "src/proton_json.c",
    "src/proton_locale.c",
    "src/proton_menu.c",
    "src/proton_state.c",
    "src/proton_update.c",
    "src/proton.c",
    "src/engine/cef_common/bridge_lifecycle.c",
    "src/engine/cef_common/browser_lifecycle.c",
    "src/engine/cef_common/browser_session.c",
    "src/engine/cef_common/bridge_policy.c",
    "src/engine/cef_common/bridge_renderer.c",
    "src/engine/cef_common/cookie_cache.c",
    "src/engine/cef_common/image.c",
    "src/engine/cef_common/profile_storage.c",
    "src/engine/cef_common/scheme.c",
    "src/engine/cef_common/view_events.c",
    "src/engine/cef_win/win_client.c",
    "src/engine/cef_win/win_dialog.c",
    "src/engine/cef_win/win_menu.c",
    "src/engine/cef_win/win_notification.c",
    "src/engine/cef_win/win_runtime.c",
    "src/engine/cef_win/win_screen.c",
    "src/engine/cef_win/win_titlebar.c",
    "src/engine/cef_win/win_view.c",
    "src/engine/cef_win/win_window.c",
    "src/engine/cef_linux/linux_client.c",
    "src/engine/cef_linux/linux_dialog.c",
    "src/engine/cef_linux/linux_menu.c",
    "src/engine/cef_linux/linux_notification.c",
    "src/engine/cef_linux/linux_runtime.c",
    "src/engine/cef_linux/linux_screen.c",
    "src/engine/cef_linux/linux_titlebar.c",
    "src/engine/cef_linux/linux_view.c",
    "src/engine/cef_linux/linux_window.c",
  ],
  link: {
    "native": { "stub-cc-flags": "${build.PROTON_NATIVE_STUB_CC_FLAGS}" },
  },
  targets: { "ffi.mbt": [ "native" ] },
)
