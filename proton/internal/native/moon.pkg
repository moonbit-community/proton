import {
  "moonbit-community/proton/internal/native/ffi" @native_ffi,
  "moonbit-community/proton_ffi" @ffi,
  "moonbit-community/proton/internal/locale",
  "moonbitlang/core/json",
  "moonbitlang/core/env",
  "moonbitlang/x/path",
}

import {
  "moonbitlang/async",
  "moonbitlang/async/fs" @async_fs,
  "moonbitlang/core/debug",
} for "wbtest"

supported_targets = "native"

options(
  "is-main": false,
  targets: {
    "ffi_constants.mbt": [ "native" ],
    "types.mbt": [ "native" ],
    "native.mbt": [ "native" ],
    "app_control.mbt": [ "native" ],
    "native_text.mbt": [ "native" ],
    "update.mbt": [ "native" ],
    "update_wbtest.mbt": [ "native" ],
    "native_wbtest.mbt": [ "native" ],
    "README.mbt.md": [ "native" ],
  },
)
