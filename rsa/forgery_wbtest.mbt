// Signatures crafted with the private key of the test vector, each chosen so
// that it decrypts to an exact encoded block. This is the only way to exercise
// the padding check end to end: an ordinary wrong signature decrypts to noise
// and is rejected long before the block structure matters.
//
// Generated by raising a chosen block to the private exponent, so every entry
// is a genuine RSA signature under the vector key. Only `forged_canonical`
// describes a well formed block.

///|
let forged_canonical_hex : String = ""

///|
let forged_short_padding_trailing_garbage_hex : String = ""

///|
let forged_missing_leading_zero_hex : String = ""

///|
let forged_wrong_block_type_hex : String = ""

///|
let forged_padding_not_all_ff_hex : String = ""

///|
let forged_missing_separator_hex : String = ""

///|
let forged_wrong_digest_algorithm_hex : String = ""

///|
let forged_different_digest_hex : String = ""

///|
test "rejects every malformed encoded block" {
  let key = vector_key()
  let digest = vector_digest()
  // Control: a correctly padded block under the same key verifies, which
  // shows the crafted signatures are valid RSA operations and that the
  // rejections below come from the padding check alone.
  assert_true(
    verify_pkcs1_sha256(key, digest, decode_hex(forged_canonical_hex)),
  )
  assert_false(
    verify_pkcs1_sha256(
      key,
      digest,
      decode_hex(forged_short_padding_trailing_garbage_hex),
    ),
  )
  assert_false(
    verify_pkcs1_sha256(
      key,
      digest,
      decode_hex(forged_missing_leading_zero_hex),
    ),
  )
  assert_false(
    verify_pkcs1_sha256(key, digest, decode_hex(forged_wrong_block_type_hex)),
  )
  assert_false(
    verify_pkcs1_sha256(key, digest, decode_hex(forged_padding_not_all_ff_hex)),
  )
  assert_false(
    verify_pkcs1_sha256(key, digest, decode_hex(forged_missing_separator_hex)),
  )
  assert_false(
    verify_pkcs1_sha256(
      key,
      digest,
      decode_hex(forged_wrong_digest_algorithm_hex),
    ),
  )
  assert_false(
    verify_pkcs1_sha256(key, digest, decode_hex(forged_different_digest_hex)),
  )
}
