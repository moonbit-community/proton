import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/process",
  "moonbitlang/core/encoding/utf8",
}

supported_targets = "native"

options(
  "allow-experimental-packages": true,
  link: { "native": { "stub-cc-flags": "${build.MACOS_STUB_FLAGS}" } },
  "native-stub": [ "clipboard_native.c" ],
  targets: { "clipboard.mbt": [ "native" ] },
)

import {
  "moonbitlang/core/async/fs" @async_fs,
  "moonbitlang/core/env",
} for "wbtest"
