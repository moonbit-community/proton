import {
  "moonbitlang/async",
  "moonbitlang/async/process",
  "moonbitlang/async/os_error",
  "moonbit-community/proton_ffi" @ffi,
  "moonbitlang/core/encoding/utf8",
}

import {
  "moonbitlang/async/fs",
  "moonbitlang/core/env",
} for "wbtest"

supported_targets = "native"

// These tests create executable helpers. Concurrent process creation can inherit
// another test's writable script descriptor and cause ETXTBSY on Linux.
// Keep concurrency inside each lifecycle test, not between test fixtures.

max_concurrent_tests = 1

options(
  "native-stub": [
    "native_common.c",
    "native_windows.c",
    "native_macos.c",
    "native_linux.c",
  ],
)
