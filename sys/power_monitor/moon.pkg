import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/pipe",
  "moonbit-community/proton_ffi" @ffi,
  "moonbitlang/core/encoding/utf8",
}

supported_targets = "native"

options(
  "allow-experimental-packages": true,
  link: {
    "native": {
      "stub-cc-flags": "${build.MACOS_STUB_FLAGS} ${build.LINUX_STUB_FLAGS}",
    },
  },
  "native-stub": [
    "native_common.c",
    "native_windows.c",
    "native_macos.c",
    "native_linux.c",
  ],
)
