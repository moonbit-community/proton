import {
  "moonbit-community/proton_ffi" @ffi,
  "moonbitlang/core/encoding/utf8",
}

supported_targets = "native"

options(
  link: { "native": { "stub-cc-flags": "${build.MACOS_STUB_FLAGS}" } },
  "native-stub": [
    "native_common.c",
    "native_windows.c",
    "native_macos.c",
    "native_linux.c",
  ],
)
